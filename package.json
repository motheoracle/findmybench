{
  "name": "findmybench",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "description": "FindMyBench — UK-first interactive bench discovery app (web + Capacitor-ready).",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "npm run build && cap sync",
    "cap:ios": "npm run cap:sync && cap open ios",
    "cap:android": "npm run cap:sync && cap open android",
    "cap:run:ios": "npm run cap:sync && cap run ios",
    "cap:run:android": "npm run cap:sync && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.4",
    "@capacitor/core": "^6.2.4",
    "@capacitor/ios": "^6.2.0",
    "@mediapipe/tasks-vision": "^1.2.3",
    "@supabase/supabase-js": "^2.119.2",
    "maplibre-contour": "^0.2.0",
    "maplibre-gl": "^4.7.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^6.2.4",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
