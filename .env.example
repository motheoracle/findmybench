# Copy to .env.local and adjust. All values are optional — sensible free defaults are built in.

# Active country (v1 ships GB only; add regions in src/config/regions.ts for v2)
VITE_COUNTRY_CODE=GB

# --- Map tiles (all three modes are FREE for every user) ---
# Default: any MapLibre style JSON URL. OpenFreeMap Liberty = keyless, no request limits.
# The same vector style also supplies labels/paths for Satellite and the base for Terrain.
VITE_MAP_STYLE_DEFAULT=https://tiles.openfreemap.org/styles/liberty
# Satellite raster XYZ tiles (Esri World Imagery — check their terms before production scale)
VITE_SATELLITE_TILES=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
VITE_SATELLITE_MAXZOOM=19
# Terrarium-encoded DEM for hillshade + client-side contour lines (Mapterhorn = open, keyless)
VITE_DEM_TILES=https://tiles.mapterhorn.com/{z}/{x}/{y}.webp
VITE_DEM_TILE_SIZE=512
VITE_DEM_MAXZOOM=12
# Raster fallback for Terrain if the vector style can't be fetched
VITE_TOPO_TILES=https://tile.opentopomap.org/{z}/{x}/{y}.png

# --- Community guardrails ---
# Pins closer than this (metres) to an existing bench are blocked as duplicates
VITE_DUPLICATE_RADIUS_M=20
# Gallery photos each user may add per bench
VITE_MAX_PHOTOS_PER_USER_PER_BENCH=3

# Show the DEV panel (subscription toggle etc.) in production builds too
VITE_ENABLE_DEV_TOOLS=false

# --- Future (v2) ---
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
